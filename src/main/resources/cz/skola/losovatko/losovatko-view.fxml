<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="window-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.skola.losovatko.LosovatkoController">

    <VBox spacing="12" styleClass="content-panel">
        <Label styleClass="main-title" text="Pochvala pro učitele" />
        <Label styleClass="subtitle" text="Losování z pěti učitelů" />

        <Button defaultButton="true" onAction="#losuj" prefWidth="200.0" styleClass="primary-button" text="Vylosovat učitele" />

        <Label styleClass="section-label" text="Vylosovaný učitel" />
        <Label id="jmeno" fx:id="jmenoLabel" alignment="CENTER" maxWidth="Infinity" minHeight="82.0" text="-----------------" />

        <Label styleClass="reason-header" text="Za co si zaslouží pochvalu?" />

        <CheckBox fx:id="bereNasVazneCheck" selected="true" text="Bere nás vážně." />
        <CheckBox fx:id="opraviBugCheck" text="Opraví bug bez „já vám to říkala“." />
        <CheckBox fx:id="vysvetliCheck" selected="true" text="Vysvětlí to klidně i potřetí." />

        <Button onAction="#udelitPochvalu" prefWidth="200.0" styleClass="primary-button, action-button" text="Udělit pochvalu" />

        <VBox fx:id="oceneniBox" managed="true" spacing="10.0" styleClass="award-box" visible="true">
            <Label styleClass="award-title" text="Udělené ocenění" />
            <Label id="oceneniUvod" fx:id="oceneniUvod" styleClass="award-text" text="Jíťa si zaslouží ocenění." />
            <VBox fx:id="dovodyBox" spacing="6.0">
                <Label styleClass="odrazka" text="• Bere nás vážně." />
                <Label styleClass="odrazka" text="• Vysvětlí to klidně i potřetí." />
            </VBox>
        </VBox>
    </VBox>
</VBox>
