<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.skola.losovatko.LosovatkoController"
      alignment="CENTER" spacing="14.0">

    <Label text="Losovátko Jíti" styleClass="nadpis" />
    <Label text="nejoblíbenější student(ka) Jíti je:"
           styleClass="popisek" wrapText="true" />

    <!-- fx:id propojuje s Javou. id vybírá prvek v CSS pomocí #jmeno. -->
    <Label fx:id="jmenoLabel" id="jmeno" text="......"
           minHeight="82.0" maxWidth="Infinity" alignment="CENTER" />

    <!-- #losuj je název metody v controlleru. -->
    <Button text="Losuj!" onAction="#losuj" defaultButton="true"
            prefWidth="200.0" />

    <Label fx:id="pocetLabel" text="Počet losování: 0" styleClass="drobny" />
    <Label text="Všech 14 jmen má stejnou šanci. Jméno se může opakovat."
           styleClass="drobny" wrapText="true" maxWidth="420.0"
           alignment="CENTER" textAlignment="CENTER" />
</VBox>
